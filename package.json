{
  "name": "notebook-cell-organizer",
  "displayName": "Notebook Cell Organizer",
  "description": "Moves shell commands and imports to dedicated cells at the top of a Jupyter notebook",
  "version": "0.2.0",
  "publisher": "showpiecep",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/showpiecep/notebook-cell-organizer"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Notebooks",
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "notebook-cell-organizer.organize",
        "title": "Organize Notebook Cells",
        "category": "Notebook",
        "icon": "$(list-ordered)"
      }
    ],
    "menus": {
      "notebook/toolbar": [
        {
          "command": "notebook-cell-organizer.organize",
          "when": "notebookType == 'jupyter-notebook'",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Notebook Cell Organizer",
      "properties": {
        "notebook-cell-organizer.organizeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically organize notebook cells when saving"
        },
        "notebook-cell-organizer.useRuffForImportSorting": {
          "type": "boolean",
          "default": false,
          "description": "Sort collected Python imports with Ruff. If the configured command is unavailable or fails, the original imports are kept and the error is written to the Notebook Cell Organizer output channel."
        },
        "notebook-cell-organizer.ruff.command": {
          "type": "string",
          "default": "ruff",
          "description": "Ruff executable name from PATH or an absolute executable path"
        },
        "notebook-cell-organizer.ruff.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "check",
            "--select",
            "I",
            "--fix",
            "${file}"
          ],
          "description": "Arguments passed to the Ruff command. ${file} is replaced with a temporary Python file containing the collected imports."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test out/test/organizer.test.js out/test/ruff.test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
